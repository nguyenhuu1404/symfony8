{
  "version": "v1",
  "hooks": [
    {
      "name": "Check IsGranted on Controller save",
      "description": "Nhắc agent kiểm tra mọi route trong Controller vừa sửa đều có #[IsGranted]",
      "trigger": "PostFileSave",
      "matcher": "src/Controller/.*\\.php$",
      "action": {
        "type": "agent",
        "prompt": "Kiểm tra file vừa lưu: mọi method có #[Route] phải có kèm #[IsGranted('resource.action')] theo đúng convention trong rbac.md. Nếu thiếu, báo cho user, KHÔNG tự ý thêm quyền mà không hỏi permission string phù hợp."
      }
    }
  ]
}
